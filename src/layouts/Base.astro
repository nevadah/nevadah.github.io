---
import '../styles/global.css';
import { getProfile } from '../lib/content';

interface Props {
  title?: string;       // page title; the site name is appended
  description?: string; // defaults to the profile headline
  image?: string;       // link preview card under /og/, without .png
}
const profile = await getProfile();
const { title } = Astro.props;
const description = Astro.props.description ?? `${profile.name}, ${profile.headline}.`;
const fullTitle = title ? `${title} · ${profile.name}` : `${profile.name}, ${profile.headline}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const imageUrl = new URL(`/og/${Astro.props.image ?? 'home'}.png`, Astro.site);
const imageAlt = `${profile.name}, ${profile.headline}`;
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  jobTitle: profile.headline,
  url: new URL('/', Astro.site).href,
  sameAs: profile.links.map((l) => l.url),
};
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{fullTitle}</title>
  <meta name="description" content={description}>
  <link rel="canonical" href={canonical}>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <meta property="og:site_name" content={profile.name}>
  <meta property="og:title" content={fullTitle}>
  <meta property="og:description" content={description}>
  <meta property="og:type" content="website">
  <meta property="og:url" content={canonical}>
  <meta property="og:image" content={imageUrl}>
  <meta property="og:image:type" content="image/png">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content={imageAlt}>
  <meta name="twitter:card" content="summary_large_image">
  <script type="application/ld+json" is:inline set:html={JSON.stringify(person)} />
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <header class="page">
    <div class="row bar">
      {Astro.url.pathname === '/' ? <span></span> : <a class="home" href="/">{profile.name}</a>}
      <nav aria-label="Site">
        <a href="/#experience">Experience</a>
        <a href="/#projects">Projects</a>
        <a href="/#writing">Writing</a>
        <a href="/#skills">Skills</a>
      </nav>
    </div>
  </header>
  <main id="main" class="page">
    <slot />
  </main>
  <footer class="page">
    <div class="row foot">
      <div></div>
      <div>
        <ul class="links">
          {profile.links.map((l) => <li><a href={l.url}>{l.label}</a></li>)}
        </ul>
        <p>This site has no tracking, no cookies, and no ads.</p>
      </div>
    </div>
  </footer>
</body>
</html>

<style>
  .bar { align-items: baseline; padding: 1.5rem 0 1rem; font-family: var(--font-ui); font-size: 0.9375rem; }
  .home { color: var(--ink); font-weight: 600; text-decoration: none; }
  nav { display: flex; flex-wrap: wrap; gap: 0.25rem 1.5rem; }
  nav a { color: var(--quiet); text-decoration: none; }
  nav a:hover { color: var(--ink); text-decoration: underline; }
  main { padding-bottom: 3rem; }
  .foot { border-top: 1px solid var(--rule); padding: 1.5rem 0 3rem; font-family: var(--font-ui); font-size: 0.875rem; color: var(--quiet); }
  .foot p { margin: 0; }
  .links { list-style: none; padding: 0; margin: 0 0 0.5rem; display: flex; gap: 1.5rem; }
  @media (max-width: 46rem) { .bar { row-gap: 0.5rem; } }
</style>
