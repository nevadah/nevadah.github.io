---
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { getProfile, getExperience, getProjects, getArticles, formatMonth } from '../lib/content';

const profile = await getProfile();
const projects = await getProjects();
const articles = await getArticles();
const roles = await Promise.all(
  (await getExperience()).map(async (role) => ({ role, Content: (await render(role)).Content, hasBody: role.body?.trim() })),
);
// The first sentence of the summary is set large; the rest at reading size.
const [lead, ...rest] = profile.summary.split(/(?<=\.)\s+/);
const articleDate = (d: Date) =>
  d.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
---
<Base>
  <section class="row intro">
    <div class="rail"></div>
    <div>
      <h1>{profile.name}</h1>
      <p class="role">{profile.headline}{profile.location && <>, {profile.location}</>}</p>
      <p class="lead">{lead}</p>
      {rest.length > 0 && <p class="rest">{rest.join(' ')}</p>}
    </div>
  </section>

  <section id="experience" class="block" aria-labelledby="experience-h">
    <div class="row"><h2 id="experience-h" class="rail">Experience</h2><div></div></div>
    {roles.map(({ role: { data }, Content, hasBody }) => (
      <article class="row entry">
        <p class="rail">{formatMonth(data.start)} to {formatMonth(data.end)}</p>
        <div>
          <h3>{data.title}</h3>
          <p class="org">{data.company}{data.location && <>, {data.location}</>}</p>
          <p>{data.summary}</p>
          {hasBody && (
            <details>
              <summary>More about this role</summary>
              <div class="body"><Content /></div>
            </details>
          )}
        </div>
      </article>
    ))}
  </section>

  <section id="projects" class="block" aria-labelledby="projects-h">
    <div class="row"><h2 id="projects-h" class="rail">Projects</h2><div></div></div>
    {projects.map(({ data }) => (
      <article class="row entry">
        <div class="rail"></div>
        <div>
          <h3>{data.url ? <a href={data.url}>{data.title}</a> : data.title}</h3>
          <p>{data.description}</p>
          {data.tech.length > 0 && <p class="small">Built with {data.tech.join(', ')}.</p>}
          <p class="small"><a href={data.repo}>Source code on GitHub</a></p>
        </div>
      </article>
    ))}
  </section>

  <section id="writing" class="block" aria-labelledby="writing-h">
    <div class="row"><h2 id="writing-h" class="rail">Writing</h2><div></div></div>
    {articles.map(({ data }) => (
      <article class="row entry">
        <p class="rail"><time datetime={data.date.toISOString().slice(0, 10)}>{articleDate(data.date)}</time></p>
        <div>
          <h3><a href={data.url}>{data.title}</a></h3>
          <p>{data.description}</p>
        </div>
      </article>
    ))}
    <div class="row"><div></div><p class="small">These articles were first published on <a href="https://www.linkedin.com/in/nevadahamaker">LinkedIn</a>, and the titles link to them there.</p></div>
  </section>

  {profile.skills.length > 0 && (
    <section id="skills" class="block" aria-labelledby="skills-h">
      <div class="row"><h2 id="skills-h" class="rail">Skills</h2><div></div></div>
      {profile.skills.map(({ group, items }) => (
        <div class="row skill">
          <p class="rail">{group}</p>
          <p>{items.join(', ')}</p>
        </div>
      ))}
    </section>
  )}

  {profile.education.length > 0 && (
    <section id="education" class="block" aria-labelledby="education-h">
      <div class="row"><h2 id="education-h" class="rail">Education</h2><div></div></div>
      {profile.education.map((line) => (
        <div class="row skill"><div class="rail"></div><p>{line}</p></div>
      ))}
    </section>
  )}
</Base>

<style>
  .intro { padding: 4.5rem 0 4rem; }
  h1 { font-size: clamp(2rem, 1.6rem + 1.6vw, 2.75rem); line-height: 1.1; font-weight: 600; letter-spacing: -0.015em; margin: 0 0 0.35rem; }
  .role { font-family: var(--font-ui); font-size: 1rem; color: var(--quiet); margin: 0 0 2.25rem; }
  .lead {
    font-size: clamp(1.4rem, 1.1rem + 1.1vw, 1.8rem);
    line-height: 1.35;
    font-weight: 380;
    letter-spacing: -0.006em;
    margin: 0 0 1.25rem;
    text-wrap: pretty;
  }
  .rest { margin: 0; color: var(--ink); text-wrap: pretty; }

  .block { border-top: 1px solid var(--rule); padding-top: 2.5rem; margin-bottom: 1.5rem; }
  h2.rail { font-size: 0.875rem; font-weight: 600; color: var(--ink); margin: 0 0 1.5rem; padding: 0; }
  .entry { margin-bottom: 2.25rem; }
  .entry .rail { margin: 0; }
  h3 { font-size: 1.25rem; line-height: 1.3; font-weight: 600; margin: 0; }
  h3 a { color: inherit; text-decoration-color: var(--rule); }
  h3 a:hover { text-decoration-color: currentColor; }
  .org { font-family: var(--font-ui); font-size: 0.9375rem; color: var(--quiet); margin: 0.15rem 0 0.6rem; }
  .entry h3 + p { margin-top: 0.4rem; }
  .small { font-family: var(--font-ui); font-size: 0.875rem; color: var(--quiet); margin-bottom: 0.4rem; }

  details { margin-top: -0.25rem; }
  summary { font-family: var(--font-ui); font-size: 0.875rem; color: var(--link); cursor: pointer; width: fit-content; list-style: none; }
  summary::-webkit-details-marker { display: none; }
  summary::before { content: '+'; display: inline-block; width: 1em; font-weight: 600; }
  details[open] summary::before { content: '\2212'; }
  summary:hover { text-decoration: underline; }
  .body { padding: 1rem 0 0.25rem 1.1rem; border-left: 2px solid var(--rule); margin-top: 0.75rem; font-size: 1.0625rem; }
  .body :global(p:last-child) { margin-bottom: 0; }

  .skill { margin-bottom: 0.6rem; }
  .skill p { margin: 0; }
  .skill .rail { padding-top: 0.2rem; }

  @media (max-width: 46rem) {
    .intro { padding: 2.5rem 0 3rem; }
    h2.rail { margin-bottom: 1rem; }
    .skill { margin-bottom: 1rem; }
  }
</style>
